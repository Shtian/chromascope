{
  "name": "chromascope",
  "version": "2.0.0",
  "author": "Stian Haga",
  "license": "ISC",
  "description": "Let your coding agent see what its UI change did. Before/after, cross-browser and URL visual diffs in real browsers, from the CLI.",
  "keywords": [
    "coding-agent",
    "ai-agent",
    "agent-skill",
    "claude-code",
    "visual-diff",
    "screenshot comparison",
    "visual regression testing",
    "cross-browser testing",
    "playwright",
    "pixelmatch",
    "UI testing",
    "diff",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Shtian/chromascope"
  },
  "homepage": "https://github.com/Shtian/chromascope#readme",
  "bugs": {
    "url": "https://github.com/Shtian/chromascope/issues"
  },
  "bin": "dist/index.js",
  "types": "./dist/types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "private": false,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "vitest --project unit",
    "build": "tsdown",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration --project e2e",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build",
    "prepare": "simple-git-hooks",
    "typecheck": "tsc --noEmit"
  },
  "simple-git-hooks": {
    "pre-push": "[ ! -d .bumpy ] || pnpm exec bumpy check --hook pre-push"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@varlock/bumpy": "^1.18.1",
    "@vitest/coverage-v8": "^5.0.5",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "cac": "^7.1.0",
    "ora": "^9.4.1",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0"
  }
}
