{
  "name": "chromascope",
  "version": "1.1.3",
  "author": "Stian Haga",
  "license": "ISC",
  "description": "Visually compare the same URL or DOM element in different browsers, from the safety of the command line.",
  "keywords": [
    "diff",
    "playwright",
    "cross-browser testing",
    "visual regression testing",
    "pixelmatch",
    "UI testing",
    "screenshot comparison",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Shtian/chromascope"
  },
  "homepage": "https://github.com/Shtian/chromascope#readme",
  "bugs": {
    "url": "https://github.com/Shtian/chromascope/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "bin": "dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "private": false,
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "vitest",
    "build": "tsup src/index.ts --format cjs,esm --minify",
    "lint": "biome check ./src",
    "format": "biome format ./src --write",
    "test": "vitest run",
    "ci": "pnpm run lint && pnpm run test && pnpm run build",
    "release": "pnpm run ci && changeset publish",
    "postinstall": "echo 'Installing required playwright browsers...' && npx playwright install chromium webkit firefox"
  },
  "peerDependencies": {
    "playwright-core": "^1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "@types/pixelmatch": "^7.1.0",
    "@types/pngjs": "^6.0.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@playwright/test": "^1.32.1",
    "cac": "^7.1.0",
    "ora": "^9.4.1",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.32.1",
    "pngjs": "^7.0.0"
  }
}
